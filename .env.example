# =============================================================================
# Batanat Agentic Harness — environment template
# =============================================================================
# Copy to .env and fill in.  `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Variables marked [phase N] are not read by the app until that phase lands;
# they are listed here so the full surface area is visible from day one.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# local | staging | production. Controls log rendering and doc exposure.
APP_ENV=local
# debug | info | warning | error
LOG_LEVEL=info
# Host/port the FastAPI app binds to.
API_HOST=127.0.0.1
API_PORT=8000
# Public base URL of the API, used to build OAuth redirect URIs and webhook URLs.
API_PUBLIC_URL=http://localhost:8000
# Public base URL of the web app, used for report permalinks and OAuth returns.
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated CORS origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Where the browser reaches the API. Only VITE_* variables are exposed to the
# client bundle — never put a secret behind a VITE_ prefix.
VITE_API_URL=http://localhost:8000
# Hard guard: this project is CPU-only and must never touch a GPU. See README.
CUDA_VISIBLE_DEVICES=


# =============================================================================
# DATASTORES
# -----------------------------------------------------------------------------
# The defaults below target services already installed on the dev machine
# (bare metal, standard ports). docker-compose.yml exists as an alternative for
# a clean machine and publishes non-default host ports so it cannot collide
# with them — if you use Compose, switch the URLs to the commented variants.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL  — relational store: users, connections, runs, approvals, tenders…
# -----------------------------------------------------------------------------
# The API creates the database at startup if it does not exist, so the role
# below only needs CREATEDB on first run.
DATABASE_URL=postgresql://postgres:password@localhost:5432/batanat
# Compose variant: postgresql://batanat:batanat@localhost:55432/batanat

# Used only by docker-compose.yml.
POSTGRES_USER=batanat
POSTGRES_PASSWORD=batanat
POSTGRES_DB=batanat
POSTGRES_HOST_PORT=55432


# -----------------------------------------------------------------------------
# Qdrant — semantic memory and document vectors
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Leave blank for local; required if you point at Qdrant Cloud.
QDRANT_API_KEY=
# Used only by docker-compose.yml.
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334


# -----------------------------------------------------------------------------
# MongoDB — raw payload archive only (raw emails, HTML snapshots, tool responses)
# -----------------------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017/
# Compose variant: mongodb://batanat:batanat@localhost:57017/?authSource=admin
MONGO_DB=batanat_raw

# Used only by docker-compose.yml.
MONGO_USER=batanat
MONGO_PASSWORD=batanat
MONGO_HOST_PORT=57017


# -----------------------------------------------------------------------------
# Redis — scheduler broker, debounce windows, rate limits
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Compose variant: redis://localhost:56379/0

# Used only by docker-compose.yml.
REDIS_HOST_PORT=56379


# -----------------------------------------------------------------------------
# Security  [phase 1]
# -----------------------------------------------------------------------------
# Fernet key used for envelope-encrypting OAuth tokens in the `connections`
# table. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates every stored token — users must reconnect.
TOKEN_ENCRYPTION_KEY=
# Secret used to sign session cookies / API tokens for the web app.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=


# -----------------------------------------------------------------------------
# Google / Gmail  [phase 2, 5]
# -----------------------------------------------------------------------------
# OAuth client (type: Web application) from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered verbatim as an authorised redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connections/gmail/callback
# Pub/Sub topic that Gmail push notifications publish to, fully qualified:
#   projects/<gcp-project-id>/topics/<topic-name>
GMAIL_PUBSUB_TOPIC=
# Service-account email Google signs push JWTs with; used to verify the webhook.
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=


# -----------------------------------------------------------------------------
# Zoho CRM  [phase 2, 4]
# -----------------------------------------------------------------------------
# Web-based client registered at https://api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/api/connections/zoho/callback
# Accounts domain to *start* the authorisation flow against. The real accounts
# URL and API domain come back in the token response and are what we persist —
# never hardcode zohoapis.com. Common values: .com .eu .in .com.au .jp
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com


# -----------------------------------------------------------------------------
# WhatsApp Cloud API  [phase 2, 6]
# -----------------------------------------------------------------------------
# One shared business number for all users; senders are mapped to users via the
# pairing-code flow.
WHATSAPP_PHONE_NUMBER_ID=
# E.164, shown in the UI and used to build the wa.me deep link, e.g. +254700000000
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Arbitrary string you also enter in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=


# -----------------------------------------------------------------------------
# Report delivery — SendGrid  [phase 6]
# -----------------------------------------------------------------------------
# Reports are sent through SendGrid, not Gmail. The Gmail connection is
# gmail.readonly by design: the agent reads the inbox and can never send from
# it. A separate credential means a leaked SendGrid key cannot read mail.
SENDGRID_API_KEY=

# Must be a sender you have verified in SendGrid (Settings → Sender
# Authentication). An unverified sender is rejected with a 403.
REPORT_FROM_EMAIL=
REPORT_FROM_NAME=Batanat Harness
# Optional: where replies go, if different from the sender.
REPORT_REPLY_TO=

# Who receives the tender reports. Comma-separated; both accept several.
# These are configuration — nothing the agent reads or produces can change
# where a report is delivered.
REPORT_TO=
REPORT_CC=


# -----------------------------------------------------------------------------
# LLM + search providers  [phase 3, 4, 8]
# -----------------------------------------------------------------------------
# Which provider the agent calls: groq | openrouter | anthropic.
# Groq and OpenRouter are OpenAI-compatible and share one client, so switching
# is an env change — no code knows the difference.
LLM_PROVIDER=groq

# Leave blank to use the provider's default open-weights model.
#   groq       → llama-3.3-70b-versatile
#   openrouter → meta-llama/llama-3.3-70b-instruct
AGENT_MODEL=

# Set the key for whichever provider you selected above.
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Tavily powers the web-search tender fallback source.
TAVILY_API_KEY=
# Embeddings. Either fastembed (local, ONNX, CPU) or an API provider.
# Never a torch-backed model — see the CPU-only section of the README.
EMBEDDINGS_PROVIDER=fastembed
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5


# -----------------------------------------------------------------------------
# Agent limits  [phase 3]
# -----------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=12
AGENT_TOKEN_BUDGET=120000
AGENT_WALL_CLOCK_TIMEOUT_S=180
# Trips a tool's circuit breaker after N consecutive failures.
TOOL_CIRCUIT_BREAKER_THRESHOLD=3
TOOL_CIRCUIT_BREAKER_COOLDOWN_S=900
# Global stop. When true, every run is refused before the model is called.
KILL_SWITCH=false
# When true, CRM writes are logged and skipped instead of executed.
CRM_DRY_RUN=true


# -----------------------------------------------------------------------------
# Scheduling  [phase 5]
# -----------------------------------------------------------------------------
# All cron expressions are evaluated in this timezone.
# Cron jobs are off by default so a one-off script never starts them.
ENABLE_SCHEDULER=false
SCHEDULER_TIMEZONE=Africa/Nairobi
TENDER_CRON_DAILY="0 11,17 * * *"
TENDER_CRON_WEEKLY="0 8 * * 1"
MAINTENANCE_CRON="0 2 * * *"


# -----------------------------------------------------------------------------
# Demo mode  [phase 9]
# -----------------------------------------------------------------------------
# When true, all external calls are served from fixtures. No credentials needed.
DEMO_MODE=false
